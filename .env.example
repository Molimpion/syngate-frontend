# URL do Backend (Sem prefixo público, usado apenas pelo servidor Next.js nos proxies)
# Exemplo: https://syngate-api.onrender.com/api/v1
API_URL=

# URL do Backend (Exposta ao navegador, usada pelo apiFetch no cliente)
# Exemplo: https://syngate-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=

# URL do Socket para comunicação em tempo real (Usado pelo navegador)
# Exemplo: wss://syngate-api.onrender.com
NEXT_PUBLIC_SOCKET_URL=

# Configurações do Ambiente
NODE_ENV=development